---
/**
 * Footer — University footer with branding, quick links, hours, contact info,
 * social icons, and a back-to-top button.
 */
import { Image } from 'astro:assets';
import logoFooterImg from '../assets/images/logosinfondoucp.png';

const quickLinks = [
  { href: '/historia', text: 'Sobre Nosotros' },
  { href: '/#admision', text: 'Admisión' },
  { href: '/#carreras', text: 'Carreras Profesionales' },
  { href: '/simulador', text: 'Simulador de Pensiones' },
  { href: '/test-vocacional', text: 'Test Vocacional' },
  { href: '/contacto', text: 'Contáctanos' },
];

const socialLinks = [
  { href: '#', icon: 'fab fa-facebook-f', label: 'Facebook' },
  { href: '#', icon: 'fab fa-instagram', label: 'Instagram' },
  { href: '#', icon: 'fab fa-linkedin-in', label: 'LinkedIn' },
  { href: '#', icon: 'fab fa-youtube', label: 'YouTube' },
  { href: '#', icon: 'fab fa-tiktok', label: 'TikTok' },
];
---

<!-- Gold accent line -->
<div class="h-1 bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>

<footer class="bg-gradient-to-b from-navy-900 to-navy-950 text-slate-400 pt-16 pb-8 relative">
  <div class="container-max">

    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-14">

      <!-- Column 1: Branding -->
      <div class="space-y-5 flex flex-col items-center md:items-start text-center md:text-left">
        <div class="bg-white/5 p-3 rounded-2xl border border-white/10 inline-block">
          <Image
            src={logoFooterImg}
            alt="Logo UCP"
            class="h-14 w-auto object-contain"
            width={160}
            height={56}
          />
        </div>
        <p class="text-sm text-slate-500 max-w-xs leading-relaxed">
          Formando profesionales líderes con excelencia académica, vocación humanística y capacidad de innovación desde 1973.
        </p>
        <!-- Social Icons -->
        <div class="flex gap-2.5">
          {socialLinks.map(social => (
            <a
              href={social.href}
              class="w-9 h-9 bg-white/5 hover:bg-gold-500 text-slate-400 hover:text-navy-950 rounded-xl flex items-center justify-center transition-all duration-300 border border-white/5 hover:border-gold-500 text-sm"
              aria-label={social.label}
            >
              <i class={social.icon}></i>
            </a>
          ))}
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-gold-500 rounded-full"></span>
          Enlaces Rápidos
        </h3>
        <ul class="space-y-2.5 text-sm">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="group text-slate-500 hover:text-gold-400 flex items-center gap-2 transition-colors">
                <i class="fas fa-chevron-right text-[8px] text-gold-500/50 group-hover:text-gold-400 group-hover:translate-x-0.5 transition-all"></i>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Working Hours -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-gold-500 rounded-full"></span>
          Horarios de Atención
        </h3>
        <ul class="space-y-4 text-sm">
          <li class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <i class="far fa-clock text-gold-500 text-xs"></i>
            </span>
            <div>
              <p class="font-semibold text-slate-300 text-xs">Lunes a Viernes</p>
              <p class="text-xs text-slate-500">08:00 AM - 06:00 PM</p>
            </div>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <i class="far fa-clock text-gold-500 text-xs"></i>
            </span>
            <div>
              <p class="font-semibold text-slate-300 text-xs">Sábados</p>
              <p class="text-xs text-slate-500">08:00 AM - 01:00 PM</p>
            </div>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <i class="fa-solid fa-ban text-slate-600 text-xs"></i>
            </span>
            <div>
              <p class="font-semibold text-slate-500 text-xs">Domingos y Feriados</p>
              <p class="text-xs text-slate-600">Cerrado</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-gold-500 rounded-full"></span>
          Contacto
        </h3>
        <ul class="space-y-3.5 text-sm">
          <li class="flex items-start gap-3 justify-center md:justify-start">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fas fa-location-dot text-gold-500 text-xs"></i>
            </span>
            <span class="text-slate-500 text-xs leading-relaxed">Av. Universidad 123, Urb. Los Cedros, Lima, Perú</span>
          </li>
          <li class="flex items-center gap-3 justify-center md:justify-start">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <i class="fas fa-phone text-gold-500 text-xs"></i>
            </span>
            <a href="tel:+51983589679" class="hover:text-gold-400 transition-colors text-xs">+51 983 589 679</a>
          </li>
          <li class="flex items-center gap-3 justify-center md:justify-start">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <i class="far fa-envelope text-gold-500 text-xs"></i>
            </span>
            <a href="mailto:info@ucp.edu.pe" class="hover:text-gold-400 transition-colors text-xs">info@ucp.edu.pe</a>
          </li>
          <li class="flex items-center gap-3 justify-center md:justify-start">
            <span class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <i class="fas fa-globe text-gold-500 text-xs"></i>
            </span>
            <a href="https://www.ucp.edu.pe" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors text-xs">www.ucp.edu.pe</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider + Bottom Bar -->
    <div class="border-t border-white/5 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-600">
        <p class="text-center md:text-left">
          &copy; 2027 <span class="font-bold text-gold-500">Universidad Carrión Porras</span>. Todos los derechos reservados.
        </p>
        <div class="flex flex-wrap justify-center gap-4 sm:gap-6 font-medium">
          <a href="/terminos" class="hover:text-gold-400 transition-colors">Términos</a>
          <a href="/privacidad" class="hover:text-gold-400 transition-colors">Privacidad</a>
          <a href="/mapa-sitio" class="hover:text-gold-400 transition-colors">Mapa del Sitio</a>
        </div>
      </div>
    </div>

  </div>

  <!-- Back to Top Button -->
  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 w-11 h-11 bg-gold-500 hover:bg-gold-600 text-navy-950 rounded-xl shadow-lg flex items-center justify-center z-40 opacity-0 translate-y-4 pointer-events-none transition-all duration-300 cursor-pointer"
    aria-label="Volver arriba"
  >
    <i class="fa-solid fa-arrow-up text-sm font-bold"></i>
  </button>
</footer>

<script>
  // Back to top button
  const backToTop = document.getElementById('back-to-top');

  window.addEventListener('scroll', () => {
    if (!backToTop) return;
    if (window.scrollY > 500) {
      backToTop.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      backToTop.classList.add('opacity-100', 'translate-y-0');
    } else {
      backToTop.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      backToTop.classList.remove('opacity-100', 'translate-y-0');
    }
  });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
