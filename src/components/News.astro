---
/**
 * News — Latest news, opinion articles, and newsletter subscription.
 * Features category filters and animated card transitions.
 */
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import scholarshipsImg from '../assets/images/news_scholarships.png';
import agreementImg from '../assets/images/news_agreement.png';
import virtualImg from '../assets/images/news_virtual.png';

const newsItems = [
  {
    type: 'noticias',
    typeLabel: 'Becas',
    image: scholarshipsImg,
    date: '15 Enero, 2027',
    readTime: '5 min',
    title: 'Nuevo programa de becas 2027: Oportunidades para todos',
    excerpt: 'Descubre nuestro renovado programa de becas diseñado para potenciar el talento de estudiantes destacados a nivel nacional.',
  },
  {
    type: 'eventos',
    typeLabel: 'Internacional',
    image: agreementImg,
    date: '12 Enero, 2027',
    readTime: '4 min',
    title: 'UCP firma convenio histórico con universidad europea',
    excerpt: 'Una alianza estratégica que abrirá nuevas puertas para intercambios estudiantiles y proyectos de investigación conjuntos.',
  },
  {
    type: 'opinion',
    typeLabel: 'Opinión',
    image: virtualImg,
    date: '10 Enero, 2027',
    readTime: '7 min',
    title: 'El futuro de la educación virtual en la era post-pandemia',
    excerpt: 'Un análisis sobre cómo la tecnología y la IA están transformando el modelo pedagógico universitario.',
  },
];

const newsFilters = [
  { key: 'all', label: 'Todas', icon: 'fa-newspaper' },
  { key: 'noticias', label: 'Noticias', icon: 'fa-bullhorn' },
  { key: 'opinion', label: 'Opinión', icon: 'fa-comment-dots' },
  { key: 'eventos', label: 'Eventos', icon: 'fa-calendar-star' },
];
---

<section class="section-padding bg-white relative">
  <div class="container-max">

    <SectionHeader
      badge="Actualidad UCP"
      title="Noticias y Opinión"
      description="Mantente al día con los últimos logros, convenios institucionales e investigaciones de nuestra comunidad académica."
    />

    <!-- Category Filters -->
    <div class="flex flex-wrap justify-center gap-2.5 mb-14">
      {newsFilters.map((f, i) => (
        <button
          data-news-filter={f.key}
          class={`news-filter-btn flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 cursor-pointer ${
            i === 0
              ? 'bg-navy-900 text-white shadow-lg'
              : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200/80 hover:border-slate-300'
          }`}
        >
          <i class={`fa-solid ${f.icon} text-xs`}></i>
          {f.label}
        </button>
      ))}
    </div>

    <!-- News Cards Grid -->
    <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 mb-20">
      {newsItems.map(item => (
        <article
          data-news-type={item.type}
          class="news-card group bg-white border border-slate-200/60 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col"
        >
          <div class="relative overflow-hidden aspect-[16/9]">
            <Image
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              width={400}
              height={225}
            />
            <div class="absolute top-3 left-3">
              <span class="bg-amber-600 text-white text-[10px] font-extrabold uppercase px-3 py-1 rounded-lg shadow-md tracking-wide">
                {item.typeLabel}
              </span>
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-4 text-xs text-slate-400 mb-3.5 font-medium">
                <span class="flex items-center gap-1.5">
                  <i class="far fa-calendar text-amber-500 text-[10px]"></i>
                  {item.date}
                </span>
                <span class="flex items-center gap-1.5">
                  <i class="far fa-clock text-amber-500 text-[10px]"></i>
                  {item.readTime} lectura
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-amber-600 transition-colors leading-snug">
                {item.title}
              </h3>
              <p class="text-slate-500 text-sm mb-5 leading-relaxed">
                {item.excerpt}
              </p>
            </div>

            <a href="#" class="inline-flex items-center gap-2 text-amber-600 font-bold hover:text-amber-700 text-sm group/link">
              <span>Leer más</span>
              <i class="fas fa-arrow-right text-xs group-hover/link:translate-x-1.5 transition-transform duration-300"></i>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Newsletter -->
    <div class="relative bg-gradient-to-br from-navy-900 via-navy-950 to-navy-900 rounded-3xl p-8 md:p-14 text-center text-white overflow-hidden shadow-2xl border border-white/5">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-gold-500 rounded-full filter blur-[120px] opacity-[0.06] pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
        <div class="w-14 h-14 rounded-2xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center mb-6">
          <i class="fa-solid fa-envelope-open-text text-gold-400 text-xl"></i>
        </div>

        <h3 class="text-2xl md:text-3xl font-extrabold mb-4 tracking-tight">Suscríbete a nuestro boletín</h3>
        <p class="text-slate-400 text-sm md:text-base mb-8 max-w-lg leading-relaxed">
          Recibe noticias sobre convocatorias, talleres gratuitos, eventos de innovación y artículos científicos.
        </p>

        <form class="flex flex-col sm:flex-row gap-3 w-full max-w-lg" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte!');">
          <input
            type="email"
            required
            placeholder="Ingresa tu correo electrónico"
            class="px-5 py-3.5 rounded-xl flex-1 border border-white/10 bg-white/5 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition-all duration-300 backdrop-blur-sm"
          />
          <button
            type="submit"
            class="btn-primary text-xs py-3.5 px-7 cursor-pointer"
          >
            <i class="fa-solid fa-paper-plane text-xs"></i>
            Suscribirse
          </button>
        </form>
      </div>
    </div>

  </div>
</section>

<script>
  // News filter logic
  const newsFilters = document.querySelectorAll('.news-filter-btn');
  const newsCards = document.querySelectorAll('.news-card');

  newsFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-news-filter');

      newsFilters.forEach(b => {
        b.classList.remove('bg-navy-900', 'text-white', 'shadow-lg');
        b.classList.add('bg-slate-50', 'text-slate-600', 'border', 'border-slate-200/80');
      });

      btn.classList.add('bg-navy-900', 'text-white', 'shadow-lg');
      btn.classList.remove('bg-slate-50', 'text-slate-600', 'border', 'border-slate-200/80');

      newsCards.forEach(card => {
        const type = card.getAttribute('data-news-type');
        const htmlCard = card as HTMLElement;

        if (filter === 'all' || type === filter) {
          htmlCard.style.display = 'flex';
          setTimeout(() => {
            htmlCard.style.opacity = '1';
            htmlCard.style.transform = 'translateY(0)';
          }, 50);
        } else {
          htmlCard.style.opacity = '0';
          htmlCard.style.transform = 'translateY(12px)';
          setTimeout(() => {
            htmlCard.style.display = 'none';
          }, 300);
        }
      });
    });
  });
</script>

<style>
  .news-card {
    transition: opacity 0.3s ease-out, transform 0.3s ease-out, box-shadow 0.3s ease;
  }
</style>
