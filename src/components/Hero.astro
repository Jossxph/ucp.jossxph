---
/**
 * Hero — Full-viewport landing section with animated geometric decorations,
 * counter stats, gradient text, and premium CTA buttons.
 */
---

<section class="relative min-h-[92vh] flex items-center justify-center bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 overflow-hidden text-white py-20">
  <!-- ─── Decorative Background Elements ─── -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-[0.04] bg-[linear-gradient(to_right,#94a3b8_1px,transparent_1px),linear-gradient(to_bottom,#94a3b8_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

    <!-- Gradient orbs -->
    <div class="absolute top-1/4 left-[10%] w-[500px] h-[500px] bg-gold-500 rounded-full filter blur-[180px] opacity-[0.08] animate-pulse"></div>
    <div class="absolute bottom-0 right-[5%] w-[400px] h-[400px] bg-amber-600 rounded-full filter blur-[150px] opacity-[0.06]"></div>
    <div class="absolute top-[10%] right-[20%] w-[300px] h-[300px] bg-blue-500 rounded-full filter blur-[140px] opacity-[0.03]"></div>

    <!-- Floating geometric shapes -->
    <div class="absolute top-[15%] right-[12%] w-20 h-20 border border-gold-500/10 rounded-2xl rotate-12 animate-float" style="animation-delay: 0s;"></div>
    <div class="absolute bottom-[25%] left-[8%] w-14 h-14 border border-white/5 rounded-full animate-float" style="animation-delay: 1.5s;"></div>
    <div class="absolute top-[60%] right-[30%] w-8 h-8 bg-gold-500/10 rounded-lg rotate-45 animate-float" style="animation-delay: 0.8s;"></div>
    <div class="absolute top-[30%] left-[25%] w-3 h-3 bg-gold-500/20 rounded-full animate-pulse"></div>
    <div class="absolute bottom-[40%] right-[15%] w-2 h-2 bg-amber-400/30 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <!-- ─── Content Container ─── -->
  <div class="relative max-w-6xl mx-auto px-4 text-center z-10 flex flex-col items-center justify-center">

    <!-- SUNEDU Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8 animate-fade-in-down">
      <span class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center">
        <i class="fa-solid fa-check text-emerald-400 text-[9px]"></i>
      </span>
      <span class="text-xs font-semibold text-slate-300 tracking-wide">Licenciada por <span class="text-emerald-400 font-bold">SUNEDU</span></span>
      <span class="text-slate-600">|</span>
      <span class="text-xs font-bold text-gold-400 tracking-wider uppercase">Admisión 2027</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black mb-6 tracking-tight leading-[1.1] max-w-5xl animate-fade-in-up">
      Universidad
      <span class="text-gold-gradient drop-shadow-sm"> Carrión Porras</span>
    </h1>

    <!-- Description -->
    <p class="text-base sm:text-lg md:text-xl text-slate-400 mb-12 max-w-3xl leading-relaxed animate-fade-in-up" style="animation-delay: 0.15s;">
      Formando líderes globales con excelencia académica, investigación de vanguardia y sólidos valores humanos para construir el futuro del país.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap justify-center gap-4 mb-16 animate-fade-in-up" style="animation-delay: 0.25s;">
      <a href="#admision" class="group btn-primary text-base px-9 py-4">
        <i class="fa-solid fa-graduation-cap text-amber-200"></i>
        <span>Admisión 2027</span>
        <i class="fa-solid fa-arrow-right group-hover:translate-x-1.5 transition-transform duration-300"></i>
      </a>

      <a href="#carreras" class="btn-secondary text-base px-9 py-4">
        <i class="fa-solid fa-book-open"></i>
        <span>Explorar Carreras</span>
      </a>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-0 w-full max-w-4xl bg-white/[0.03] backdrop-blur-md rounded-2xl border border-white/[0.06] shadow-2xl overflow-hidden animate-fade-in-up" style="animation-delay: 0.35s;">
      <div class="stat-item group p-6 md:p-8 text-center border-r border-b md:border-b-0 border-white/[0.06]">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gold-400 mb-1.5 group-hover:scale-110 transition-transform duration-300" data-count="25" data-suffix="+">0</div>
        <div class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-[0.15em] font-semibold">Años de Trayectoria</div>
      </div>
      <div class="stat-item group p-6 md:p-8 text-center border-b md:border-b-0 md:border-r border-white/[0.06]">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gold-400 mb-1.5 group-hover:scale-110 transition-transform duration-300" data-count="15" data-suffix="K+">0</div>
        <div class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-[0.15em] font-semibold">Alumnos Egresados</div>
      </div>
      <div class="stat-item group p-6 md:p-8 text-center border-r border-white/[0.06]">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gold-400 mb-1.5 group-hover:scale-110 transition-transform duration-300" data-count="30" data-suffix="+">0</div>
        <div class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-[0.15em] font-semibold">Especialidades</div>
      </div>
      <div class="stat-item group p-6 md:p-8 text-center">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gold-400 mb-1.5 group-hover:scale-110 transition-transform duration-300" data-count="95" data-suffix="%">0</div>
        <div class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-[0.15em] font-semibold">Empleabilidad</div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <a href="#admision" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 opacity-40 hover:opacity-80 transition-opacity duration-300 cursor-pointer group">
    <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-slate-500">Descubre más</span>
    <div class="w-5 h-8 border-2 border-slate-500 rounded-full flex items-start justify-center p-1 group-hover:border-gold-500 transition-colors">
      <div class="w-1 h-2 bg-gold-500 rounded-full animate-bounce"></div>
    </div>
  </a>
</section>

<script>
  // Counter animation for hero stats
  function animateCounters() {
    const counters = document.querySelectorAll('[data-count]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.count || '0');
          const suffix = el.dataset.suffix || '';
          let current = 0;
          const duration = 1500;
          const step = target / (duration / 16);

          const timer = setInterval(() => {
            current += step;
            if (current >= target) {
              current = target;
              clearInterval(timer);
            }
            el.textContent = Math.floor(current) + suffix;
          }, 16);

          observer.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(counter => observer.observe(counter));
  }

  animateCounters();
</script>
