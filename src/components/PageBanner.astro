---
/**
 * PageBanner — Reusable hero banner for subpages.
 * Provides a consistent dark header with geometric grid pattern.
 */
interface Props {
  badge: string;
  title: string;
  description: string;
}

const { badge, title, description } = Astro.props;
---

<section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 text-white py-24 md:py-28 overflow-hidden">
  <!-- Geometric grid pattern -->
  <div class="absolute inset-0 opacity-[0.07] bg-[linear-gradient(to_right,#94a3b8_1px,transparent_1px),linear-gradient(to_bottom,#94a3b8_1px,transparent_1px)] bg-[size:3rem_3rem]"></div>

  <!-- Decorative gradient orbs -->
  <div class="absolute top-0 right-0 w-72 h-72 bg-gold-500 rounded-full filter blur-[120px] opacity-[0.06] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-56 h-56 bg-amber-500 rounded-full filter blur-[100px] opacity-[0.05] pointer-events-none"></div>

  <!-- Gold top accent line -->
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-gold-500 to-transparent opacity-60"></div>

  <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
    <span class="badge-dark mb-4 animate-fade-in">
      <i class="fa-solid fa-circle text-[5px] opacity-60"></i>
      {badge}
    </span>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-6 animate-fade-in-up">
      {title}
    </h1>

    <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-2xl mx-auto animate-fade-in-up" style="animation-delay: 0.1s;">
      {description}
    </p>

    <!-- Breadcrumb -->
    <nav class="mt-8 flex items-center justify-center gap-2 text-xs text-slate-500 animate-fade-in" style="animation-delay: 0.2s;">
      <a href="/" class="hover:text-gold-400 transition-colors flex items-center gap-1">
        <i class="fa-solid fa-house text-[10px]"></i> Inicio
      </a>
      <i class="fa-solid fa-chevron-right text-[8px] text-slate-600"></i>
      <span class="text-gold-400 font-semibold">{title}</span>
    </nav>
  </div>
</section>
