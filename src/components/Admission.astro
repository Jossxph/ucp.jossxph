---
/**
 * Admission — Admission process section with modality cards and timeline.
 * Uses SectionHeader for consistency.
 */
import SectionHeader from './SectionHeader.astro';
---

<section id="admision" class="section-padding bg-slate-50 relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute -right-40 top-1/4 w-[500px] h-[500px] bg-amber-100 rounded-full filter blur-[120px] opacity-40 pointer-events-none"></div>
  <div class="absolute -left-40 bottom-1/4 w-[400px] h-[400px] bg-blue-50 rounded-full filter blur-[120px] opacity-40 pointer-events-none"></div>

  <div class="container-max relative z-10">

    <SectionHeader
      badge="Convocatoria Vigente"
      title="Proceso de Admisión 2027"
      description="¡Inicia tu camino hacia el éxito profesional! Sé parte de nuestra comunidad universitaria y prepárate para los retos del futuro con una formación global."
    />

    <!-- Modality Cards Grid -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 mb-20">

      <!-- Card 1: Admisión Regular -->
      <div class="bg-white p-8 rounded-2xl border border-slate-200/60 shadow-md card-hover flex flex-col justify-between group">
        <div>
          <div class="icon-box-light mb-6 group-hover:bg-amber-600 group-hover:text-white">
            <i class="fas fa-user-graduate text-xl"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Admisión Regular</h3>
          <p class="text-slate-500 text-sm mb-6 leading-relaxed">
            Dirigido a estudiantes egresados de educación secundaria completa que buscan postular mediante evaluación de conocimientos general.
          </p>
        </div>
        <ul class="text-sm text-slate-600 space-y-3 pt-6 border-t border-slate-100">
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-emerald-500 text-sm"></i>
            <span>Examen de Admisión General</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-emerald-500 text-sm"></i>
            <span>Entrevista Personal Vocacional</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-emerald-500 text-sm"></i>
            <span>Test Psicotécnico Gratuito</span>
          </li>
        </ul>
      </div>

      <!-- Card 2: Primeros Puestos (Featured) -->
      <div class="relative bg-gradient-to-br from-navy-900 to-navy-950 p-8 rounded-2xl border border-white/5 shadow-xl card-hover flex flex-col justify-between text-white overflow-hidden group">
        <!-- Corner badge -->
        <div class="absolute top-0 right-0 bg-gradient-to-r from-gold-500 to-amber-500 text-navy-950 text-[10px] font-extrabold uppercase px-4 py-1.5 rounded-bl-2xl tracking-wider">
          <i class="fa-solid fa-crown text-[9px] mr-1"></i> Ingreso Directo
        </div>

        <!-- Decorative glow -->
        <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-gold-500 rounded-full filter blur-[60px] opacity-[0.07] pointer-events-none"></div>

        <div class="relative z-10">
          <div class="icon-box-dark mb-6 group-hover:bg-gold-500 group-hover:text-navy-950 group-hover:border-gold-500">
            <i class="fas fa-medal text-xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Primeros Puestos</h3>
          <p class="text-slate-400 text-sm mb-6 leading-relaxed">
            Modalidad especial para alumnos egresados que ocuparon los dos primeros puestos en educación secundaria.
          </p>
        </div>
        <ul class="text-sm text-slate-400 space-y-3 pt-6 border-t border-white/5 relative z-10">
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-gold-500 text-sm"></i>
            <span>Evaluación de Carpeta Escolar</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-gold-500 text-sm"></i>
            <span>Beca de Honor en Matrícula</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-gold-500 text-sm"></i>
            <span>Acceso Preferencial UCP</span>
          </li>
        </ul>
      </div>

      <!-- Card 3: Traslado Externo -->
      <div class="bg-white p-8 rounded-2xl border border-slate-200/60 shadow-md card-hover flex flex-col justify-between group">
        <div>
          <div class="icon-box-light mb-6 group-hover:bg-amber-600 group-hover:text-white">
            <i class="fas fa-right-left text-xl"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Traslado Externo</h3>
          <p class="text-slate-500 text-sm mb-6 leading-relaxed">
            Para estudiantes en curso o egresados de otras universidades o institutos superiores convalidando sus materias.
          </p>
        </div>
        <ul class="text-sm text-slate-600 space-y-3 pt-6 border-t border-slate-100">
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-emerald-500 text-sm"></i>
            <span>Convalidación de Cursos</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-emerald-500 text-sm"></i>
            <span>Asesoría Curricular Personalizada</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fas fa-circle-check text-emerald-500 text-sm"></i>
            <span>Requisitos Flexibles</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Timeline / Cronograma -->
    <div class="bg-white border border-slate-200/60 rounded-3xl p-8 md:p-12 shadow-lg">
      <h3 class="text-2xl font-bold text-slate-900 text-center mb-12 tracking-tight flex items-center justify-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
          <i class="fa-regular fa-calendar-check text-amber-600"></i>
        </span>
        Cronograma de Admisión
      </h3>

      <div class="grid md:grid-cols-3 gap-8 md:gap-4 relative">
        <!-- Connecting line (desktop) -->
        <div class="hidden md:block absolute top-8 left-[20%] right-[20%] h-[2px] bg-gradient-to-r from-gold-500/20 via-gold-500/40 to-gold-500/20 z-0"></div>

        <!-- Step 1 -->
        <div class="text-center flex flex-col items-center relative z-10">
          <div class="w-16 h-16 bg-navy-900 text-white rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-navy-900/20">
            <i class="fa-solid fa-file-pen text-gold-400 text-lg"></i>
          </div>
          <h4 class="font-bold text-slate-800 mb-1">Inscripciones</h4>
          <span class="inline-flex items-center gap-1 text-[10px] text-emerald-600 font-bold uppercase tracking-widest mb-1.5 bg-emerald-50 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> Abiertas
          </span>
          <p class="text-sm text-slate-500 font-medium">15 de Enero al 28 de Febrero</p>
        </div>

        <!-- Step 2 -->
        <div class="text-center flex flex-col items-center relative z-10">
          <div class="w-16 h-16 bg-navy-900 text-white rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-navy-900/20">
            <i class="fa-solid fa-file-invoice text-gold-400 text-lg"></i>
          </div>
          <h4 class="font-bold text-slate-800 mb-1">Examen de Admisión</h4>
          <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1.5">Evaluación</span>
          <p class="text-sm text-slate-500 font-medium">Domingo, 10 de Marzo</p>
        </div>

        <!-- Step 3 -->
        <div class="text-center flex flex-col items-center relative z-10">
          <div class="w-16 h-16 bg-navy-900 text-white rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-navy-900/20">
            <i class="fa-solid fa-clipboard-list text-gold-400 text-lg"></i>
          </div>
          <h4 class="font-bold text-slate-800 mb-1">Resultados y Matrícula</h4>
          <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1.5">Cierre</span>
          <p class="text-sm text-slate-500 font-medium">A partir del 15 de Marzo</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-14 flex flex-col items-center gap-4">
      <a href="#" class="btn-primary text-base px-9 py-4 group">
        <span>Postular Ahora</span>
        <i class="fas fa-arrow-right group-hover:translate-x-1.5 transition-transform"></i>
      </a>
      <p class="text-sm text-slate-400 flex items-center gap-2">
        <i class="fa-solid fa-headset text-amber-500"></i>
        ¿Necesitas orientación? <a href="mailto:admision@ucp.edu.pe" class="text-amber-600 font-semibold hover:underline">admision@ucp.edu.pe</a>
      </p>
    </div>

  </div>
</section>
