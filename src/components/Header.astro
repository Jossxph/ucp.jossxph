---
/**
 * Header — Main navigation with top utility bar, sticky nav, dropdowns, and mobile drawer.
 * Uses Font Awesome 6 icons exclusively.
 */
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logosinfondoucp.png';

const pathname = Astro.url.pathname;

/* Navigation data — keeps template clean */
const navGroups = [
  {
    label: 'Sobre Nosotros',
    id: 'sobre-nosotros',
    activePaths: ['/historia', '/mision-vision', '/acreditacion'],
    items: [
      { href: '/historia', icon: 'fa-landmark', text: 'Historia Institucional' },
      { href: '/mision-vision', icon: 'fa-bullseye', text: 'Misión, Visión y Valores' },
      { href: '/acreditacion', icon: 'fa-medal', text: 'Acreditación de Calidad' },
    ],
  },
  {
    label: 'Académico',
    id: 'academico',
    activePaths: ['/posgrado', '/educacion-continua', '/simulador'],
    items: [
      { href: '/#carreras', icon: 'fa-user-graduate', text: 'Carreras de Pregrado' },
      { href: '/posgrado', icon: 'fa-award', text: 'Programas de Posgrado' },
      { href: '/educacion-continua', icon: 'fa-laptop-code', text: 'Educación Continua' },
      { href: '/simulador', icon: 'fa-calculator', text: 'Simulador de Pensiones' },
    ],
  },
  {
    label: 'Admisión',
    id: 'admision',
    activePaths: ['/becas', '/test-vocacional'],
    items: [
      { href: '/#admision', icon: 'fa-calendar-days', text: 'Proceso de Admisión 2027' },
      { href: '/becas', icon: 'fa-hand-holding-dollar', text: 'Becas y Financiamiento' },
      { href: '/test-vocacional', icon: 'fa-clipboard-question', text: 'Test Vocacional UCP' },
    ],
  },
  {
    label: 'Vida Universitaria',
    id: 'vida-univ',
    activePaths: ['/vida-universitaria', '/bolsa-trabajo'],
    items: [
      { href: '/vida-universitaria', icon: 'fa-users', text: 'Talleres y Deportes' },
      { href: '/bolsa-trabajo', icon: 'fa-briefcase', text: 'Bolsa de Trabajo UCP' },
    ],
  },
];

const isGroupActive = (paths: string[]) =>
  paths.some(p => pathname === p || pathname === p + '/');

const isContactoActive = pathname === '/contacto' || pathname === '/contacto/';
---

<!-- ═══════════════════ Top Utility Bar ═══════════════════ -->
<div class="bg-navy-950 text-slate-400 text-xs py-2.5 border-b border-white/5">
  <div class="container-max flex flex-col sm:flex-row justify-between items-center gap-2">
    <div class="flex items-center gap-5">
      <a href="tel:+51983589679" class="flex items-center gap-1.5 hover:text-gold-400 transition-colors">
        <i class="fa-solid fa-phone text-gold-500 text-[10px]"></i>
        +51 983 589 679
      </a>
      <span class="text-slate-700 hidden sm:inline">|</span>
      <a href="mailto:info@ucp.edu.pe" class="flex items-center gap-1.5 hover:text-gold-400 transition-colors">
        <i class="fa-solid fa-envelope text-gold-500 text-[10px]"></i>
        info@ucp.edu.pe
      </a>
    </div>
    <div class="flex items-center gap-5">
      <a href="#" class="hover:text-gold-400 transition-colors flex items-center gap-1.5">
        <i class="fa-solid fa-graduation-cap text-gold-500 text-[10px]"></i> Campus Virtual
      </a>
      <span class="text-slate-700">|</span>
      <a href="#" class="hover:text-gold-400 transition-colors flex items-center gap-1.5">
        <i class="fa-solid fa-book-open text-gold-500 text-[10px]"></i> Biblioteca
      </a>
      <span class="text-slate-700">|</span>
      <a href="/acreditacion" class="hover:text-gold-400 transition-colors flex items-center gap-1.5">
        <i class="fa-solid fa-shield-halved text-gold-500 text-[10px]"></i> Transparencia
      </a>
    </div>
  </div>
</div>

<!-- ═══════════════════ Main Sticky Header ═══════════════════ -->
<header id="main-header" class="sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-slate-100 shadow-sm transition-all duration-300">
  <div class="container-max">
    <div class="flex justify-between items-center h-20 transition-all duration-300" id="navbar-container">

      <!-- ─── Logo + Branding ─── -->
      <a href="/" class="flex items-center gap-3.5 group flex-shrink-0">
        <div class="h-11 w-auto overflow-hidden">
          <Image
            src={logoImg}
            alt="UCP Emblem"
            class="h-11 w-auto object-contain transition-all duration-300"
            id="navbar-logo"
            loading="eager"
            width={120}
            height={44}
          />
        </div>
        <div class="flex flex-col select-none border-l-2 border-slate-200 pl-3.5 transition-all duration-300" id="navbar-text">
          <span class="text-2xl font-black text-slate-900 leading-none tracking-tight group-hover:text-amber-600 transition-colors">UCP</span>
          <span class="text-[10px] font-extrabold text-slate-500 tracking-[0.12em] uppercase leading-none mt-1.5">
            Universidad <span class="text-amber-700">Carrión Porras</span>
          </span>
        </div>
      </a>

      <!-- ─── Desktop Nav ─── -->
      <nav class="hidden lg:flex items-center gap-0.5 h-full">
        {navGroups.map(group => (
          <div class="relative group h-full flex items-center">
            <button class={`nav-link ${isGroupActive(group.activePaths) ? 'nav-link--active' : ''} cursor-pointer`}>
              {group.label}
              <i class="fa-solid fa-chevron-down text-[9px] opacity-40 group-hover:opacity-100 group-hover:rotate-180 transition-all duration-300"></i>
            </button>

            <!-- Dropdown -->
            <div class="absolute left-1/2 -translate-x-1/2 top-[80%] hidden group-hover:block w-64 pt-2 z-50">
              <div class="bg-white rounded-2xl border border-slate-100 shadow-2xl py-2 overflow-hidden animate-fade-in-down">
                <div class="h-[3px] bg-gradient-to-r from-gold-500 via-amber-400 to-gold-500 rounded-full mx-4 mb-2"></div>
                {group.items.map(item => (
                  <a href={item.href} class="flex items-center gap-3 px-5 py-2.5 text-sm text-slate-600 hover:bg-amber-50 hover:text-amber-700 transition-all duration-200 font-medium">
                    <span class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
                      <i class={`fa-solid ${item.icon} text-amber-600 text-xs`}></i>
                    </span>
                    {item.text}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}

        <a href="/contacto" class={`nav-link ${isContactoActive ? 'nav-link--active' : ''}`}>
          Contacto
        </a>
      </nav>

      <!-- ─── CTA Button ─── -->
      <div class="hidden lg:flex items-center">
        <a href="/#admision" class="btn-primary text-xs animate-pulse-glow">
          <i class="fa-solid fa-paper-plane"></i>
          Postula 2027
        </a>
      </div>

      <!-- ─── Mobile Toggle ─── -->
      <button id="mobile-menu-button" class="lg:hidden text-slate-700 hover:text-amber-600 p-2.5 rounded-xl hover:bg-slate-50 transition-colors cursor-pointer" aria-label="Abrir Menú">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- ═══════════════════ Mobile Drawer ═══════════════════ -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white shadow-xl">
    <div class="px-5 pt-3 pb-6 space-y-1.5">
      {navGroups.map(group => (
        <div class="mobile-dropdown">
          <button class={`w-full text-left py-3 text-sm font-bold ${isGroupActive(group.activePaths) ? 'text-amber-600' : 'text-slate-800'} hover:text-amber-600 flex justify-between items-center border-b border-slate-50 cursor-pointer`}>
            {group.label}
            <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300"></i>
          </button>
          <div class="hidden pl-3 mt-1 space-y-0.5 bg-slate-50/80 rounded-xl p-2.5">
            {group.items.map(item => (
              <a href={item.href} class="flex items-center gap-3 py-2 text-sm text-slate-600 hover:text-amber-600 font-medium">
                <span class="w-7 h-7 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
                  <i class={`fa-solid ${item.icon} text-amber-600 text-[10px]`}></i>
                </span>
                {item.text}
              </a>
            ))}
          </div>
        </div>
      ))}

      <a href="/contacto" class={`block py-3 text-sm font-bold ${isContactoActive ? 'text-amber-600' : 'text-slate-800'} hover:text-amber-600 border-b border-slate-50`}>
        Contacto
      </a>

      <div class="pt-4">
        <a href="/#admision" class="btn-primary w-full justify-center text-xs">
          <i class="fa-solid fa-paper-plane"></i>
          Postula a UCP 2027
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Desktop nav link base */
  .nav-link {
    position: relative;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-slate-600);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: all 0.3s ease;
  }
  .nav-link:hover { color: var(--color-amber-600); }

  .nav-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2.5px;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(to right, var(--color-gold-500), var(--color-amber-500));
    border-radius: 9999px;
    transition: all 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    width: 80%;
  }

  .nav-link--active {
    color: var(--color-amber-600);
    font-weight: 800;
  }
</style>

<script>
  // ── Mobile drawer toggle ──
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // ── Mobile dropdown submenus ──
  document.querySelectorAll('.mobile-dropdown button').forEach(button => {
    button.addEventListener('click', () => {
      const dropdown = button.nextElementSibling;
      const chevron = button.querySelector('.fa-chevron-down');

      if (dropdown) dropdown.classList.toggle('hidden');
      if (chevron) {
        chevron.classList.toggle('rotate-180');
        (chevron as HTMLElement).style.transition = 'transform 0.3s ease';
      }
    });
  });

  // ── Shrink header on scroll ──
  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const header = document.getElementById('main-header');
    const navLogo = document.getElementById('navbar-logo');
    const navContainer = document.getElementById('navbar-container');

    if (!header || !navLogo || !navContainer) return;

    if (window.scrollY > 40) {
      header.classList.add('shadow-md');
      header.classList.replace('bg-white/95', 'bg-white/98');
      navContainer.classList.replace('h-20', 'h-16');
      navLogo.classList.replace('h-11', 'h-9');
    } else {
      header.classList.remove('shadow-md');
      header.classList.replace('bg-white/98', 'bg-white/95');
      navContainer.classList.replace('h-16', 'h-20');
      navLogo.classList.replace('h-9', 'h-11');
    }

    lastScrollY = window.scrollY;
  });
</script>
